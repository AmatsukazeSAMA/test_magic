      "per_criterion_assessments": [
        {
          "criterion": "卷形与连续性",
          "status": "retained_visible_static_P2_open",
          "observation": "正常整图及3x中，上中宽灰前面翻回较窄斜灰内返，内返两边接上下面，再逐步收细进末C。各间窄灰面是真返回而非需挖掉的空隙；未见各片独立封成帽盘、透明全断或仅薄荷线贴实体锥。返回上规则短分割线较机械，但灰带仍连接。",
          "treatment": "保留当前可见灰前/返路径；返窄和短分割线P2，不因opaque灰/无固定孔数否决，也不认证背向隐藏完整几何。",
          "not_observable": "bob后根/卷背向面及完整轴心。"
        },
        {
          "criterion": "发量与投影",
          "status": "retained_visible_static",
          "observation": "完整头肩中卷有足够宽灰面，沿肩前到上胸的C仍高于腰，无新增腰边长尾；也未缩成小mint挂件。实际邻63白底对照中保持相近身份发量上下文，但此处是本1098独立投影。",
          "treatment": "可保当前可见体量，不固定圈/孔/像素比例；邻63仅静态对照。",
          "not_observable": "摄影后的体量连续性、三维总量及动态过渡。"
        },
        {
          "criterion": "发根与连接",
          "status": "retained_visible_static",
          "observation": "唯一双珠组在画右低耳后/bob下颌nape接灰卷，一珠清楚、另一较多被侧发遮。画左无第二束，未抬到眼/帽位，无明显悬空/贴片接缝。",
          "treatment": "保留固定人物LEFT低根，不为露珠补到另一侧。",
          "not_observable": "bob后完整头皮接点。"
        },
        {
          "criterion": "材质与画风",
          "status": "P2_open",
          "observation": "bob及卷宽主面/内返为灰；mint是较细的斜材料线/边，局部零碎不均匀，C稍偏冷灰绿，灰面仍soft。没有银白亮条、重复深暗体积底块或整束主面薄荷化。",
          "treatment": "薄mint斜线/soft色差及返回细暗线P2开放，严格全平涂未认证；不拿量色代替艺术看图。",
          "not_observable": "不能从技术阈值认证画风。"
        },
        {
          "criterion": "空间遮挡",
