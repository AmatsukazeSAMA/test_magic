      "per_criterion_assessments": [
        {
          "criterion": "卷形与连续性",
          "status": "retained_visible_static_P2_open",
          "observation": "正常整图和实际3x中，首宽灰面下的灰返回斜接第二宽面，再经画右窄灰回边接下段。可见灰带有前后翻回关系，未见每片独立封口/完全断开。下段在白肩褶和交叉袖腕后收住，没有独立暴露完整C。",
          "treatment": "保留可见灰带；上面圆钝、返面压窄/规整分层记P2，不因灰不透明判实心，也不因遮挡认证隐藏全卷。",
          "not_observable": "白褶/袖腕后的完整末C及隐藏中段。"
        },
        {
          "criterion": "发量与投影",
          "status": "retained_visible_static",
          "observation": "完整头肩/全人中可见上部有数个宽灰面，宽度相对bob具有实际发量，没有缩成独立细mint柱，也未占成过大粗重卷。可见束向下收，符合当前原向外下回收阶段；部分下段确被原前景衣/手挡住，不能按露高直接判小。",
          "treatment": "当前静态投影可保；不固定圈数/孔数/长度，不替隐藏部分宣称足量。",
          "not_observable": "总隐藏发量、相邻摄影比例跳变及真实摆动速度。"
        },
        {
          "criterion": "发根与连接",
          "status": "retained_visible_static",
          "observation": "唯一卷位于画右bob下后侧，靠颌/nape的低红珠连接；一珠清楚、另一部分被bob遮住。画左近耳无另装珠卷，未抬到帽/眼高，没有可见悬空拼接边。",
          "treatment": "保留同一解剖LEFT低根，不为露双珠补在近侧；bob后连接未完全可见。",
          "not_observable": "头皮及bob后完整珠组接点。"
        },
        {
          "criterion": "材质与画风",
          "status": "P2_open",
