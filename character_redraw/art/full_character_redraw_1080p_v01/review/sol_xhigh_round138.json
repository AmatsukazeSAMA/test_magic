      "per_criterion_assessments": [
        {
          "criterion": "卷形与连续性",
          "status": "visible_returns_observed_phase_repair_required",
          "observation": "完整图和新3x可见灰宽前面在左下翻回到内侧，接下一灰面与收细C，未发现可明确单列P1的独立封口盘堆；不是因opaque gray或未露大孔就判实心。上中两个宽面收拢、内返露量少，形状可读性仍P2开放，不能因C存在自动认证所有上端。",
          "treatment": "修整束相位时保住宽灰前/返和合理体量，不挖掉gray返回、不把其改成薄mint管或只转C。",
          "not_observable": "隐藏内后返回的完整几何不可认证，本稿不是通用完整卷master。"
        },
        {
          "criterion": "发量与投影",
          "status": "P1_visible_phase_projection_repair_required",
          "observation": "根位虽已低且正确，但两片主宽灰面/下灰返整体从红珠向右下坠，主要灰体仍在低珠下方；只有末C回起。实际55整束在bob侧近根高度向外翻，1066原源/既有源审要求承接1058继续out/up。本稿整束更像向下收拢，未把当前继续上提落实在主卷体。对齐眼轴作只读说明后此差异仍清楚，不能归因于头转正或屏幕绝对y。",
          "treatment": "从固定低LEFT根重新安排整个宽灰前/返体向外/上翻，保新56正确较直头和原手动作；不能抬红珠安装点、仅抬尾C，或回用旧55歪头作身份。",
          "not_observable": "没有实际原速/慢速播放；此P1是当前可见静态运动投影不合阶段，不是速度/动力学/跳跃物理结论。"
        },
        {
          "criterion": "发根与连接",
          "status": "visible_static_retained",
          "observation": "短bob恢复，旧局修高灰珠/巨大高卷/长尖刘海已去。唯一红双珠组在当前画右远侧LEFT下颌后/低bob-nape，一珠部分被bob遮，接同侧单卷。没有换到近侧RIGHT、耳上高根或透明全断。",
          "treatment": "保此正确低根；调整主卷位置时只让发带摆动，不能抬根或镜像身体。",
          "not_observable": "被bob盖住的根内连接不认证。"
        },
        {
          "criterion": "材质与画风",
          "status": "P2_open_no_separate_eye_or_hair_lighting_P1",
          "observation": "双眼保原1066弧形开度/两眼差别，左眼已摆脱旧55压扁式；瞳面为单深色加普通小白点，无独立黑心灰环。bob和卷主面/返以灰为主、mint为边，未见银白强光条或重复深暗体积底块；局部softgray/mint较宽仍P2。",
          "treatment": "保新眼和灰材料；不将普通小白点颗数当硬拒绝，不为修phase改回旧眼。严格平涂不认证。"
        },
        {
          "criterion": "空间遮挡",
          "status": "visible_structure_observed_phase_repair_required",
          "observation": "当前bob只遮部分低根，卷体两宽面基本全露在头侧/手左，不存在足以把整个上翻主体隐藏掉的前景大遮挡；白肩frill在其下方，没有把整束up藏起来。不能拿隐藏或末C方向解释主灰体整体向下。",
          "treatment": "用当前原1066头/肩/手空间安排真实上翻和必要遮挡，不能扩大frill或微缩卷假装已满足阶段。",
          "not_observable": "隐藏轴心/尾段不强补，远侧三维具体姿态和动态仍pending。"
        },
        {
          "criterion": "整个人物及透明边缘",
          "status": "head_pose_repaired_body_retained_registration_pending",
